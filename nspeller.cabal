cabal-version:      3.0
name:               nspeller
version:            0.3.0
synopsis:           Компилятор умных подборок Navidrome из файлов .mix
description:        nspeller компилирует человекочитаемые правила умных музыкальных
                    подборок из файлов .mix в JSON-файлы .nsp, которые поддерживает
                    Navidrome Smart Playlists. В пакет также входит Muzlovar —
                    веб-редактор умных подборок поверх того же ядра.
license:            MIT
license-file:       LICENSE
author:             nspeller contributors
maintainer:         nspeller contributors
category:           Music
build-type:         Simple
extra-doc-files:
    README.md
    CONTRIBUTING.md
    SECURITY.md
    docs/nspeller-reference.ru.md

source-repository head
  type:             git
  location:         https://github.com/zamyatinmn/muzlovar.git

common warnings
  ghc-options:
      -Wall
      -Wcompat
      -Widentities
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wmissing-export-lists
      -Wredundant-constraints
  default-language: GHC2021

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:
      Nspeller.Ast
      Nspeller.Cli
      Nspeller.Compiler
      Nspeller.Fields
      Nspeller.Navidrome
      Nspeller.Parser
      Nspeller.Render
      Nspeller.Schema
      Nspeller.Validation
      Nspeller.Muzlovar.Assets
      Nspeller.Muzlovar.Html
      Nspeller.Muzlovar.Server
      Nspeller.Muzlovar.Store
      Nspeller.Muzlovar.Subsonic
      Nspeller.Muzlovar.Types

  build-depends:
      aeson
    , aeson-pretty
    , base >=4.17 && <5
    , base64-bytestring
    , bytestring
    , directory
    , file-embed
    , filepath
    , http-client
    , http-client-tls
    , http-types
    , lucid
    , megaparsec >=9.0
    , optparse-applicative >=0.16
    , scotty >=0.30
    , scientific
    , text
    , time
    , wai
    , warp

  if !os(windows)
    build-depends: unix

executable nspeller
  import:           warnings
  hs-source-dirs:   app
  main-is:          Main.hs
  ghc-options:      -threaded
  build-depends:
      base
    , nspeller

executable muzlovar
  import:           warnings
  hs-source-dirs:   muzlovar
  main-is:          Main.hs
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"
  build-depends:
      base
    , nspeller
    , text
    , warp

  if !os(windows)
    build-depends: unix

test-suite nspeller-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:
      DtoTests
      Generators
      GoldenTests
      Properties
      RegistryTests
      RoundTripTests
      SchemaTests
      ServerTests
      StoreTests
      UnitTests

  build-depends:
      aeson
    , base
    , bytestring
    , directory
    , filepath
    , http-types
    , nspeller
    , QuickCheck >=2.14
    , scientific
    , tasty
    , tasty-golden
    , tasty-hunit
    , tasty-quickcheck
    , text
    , time
    , wai
    , wai-extra
