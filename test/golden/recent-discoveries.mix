# Абсолютные даты: пара >=/<= склеивается в inTheRange, до/после
# и вложенная ветвь «любое» с относительными днями.
подборка "Свежие находки"
описание "Добавлено в 2024 году и давно не звучало"

где все {
  добавлено >= 2024-01-01
  добавлено <= 2024-12-31
  последнее_прослушивание до 2024-06-01
  любое {
    не звучало 30 дней
    последнее_прослушивание после 2023-01-01
  }
}

лимит 50
