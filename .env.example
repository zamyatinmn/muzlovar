# Copy this file to .env only when you need authentication or Subsonic access.
# Authentication is disabled when both credential values are empty.
MUZLOVAR_USERNAME=
MUZLOVAR_PASSWORD=

# Optional: all three values are required to enable the Subsonic adapter.
MUZLOVAR_SUBSONIC_URL=
MUZLOVAR_SUBSONIC_USER=
MUZLOVAR_SUBSONIC_PASSWORD=
